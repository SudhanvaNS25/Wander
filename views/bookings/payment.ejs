<% layout("/layouts/boilerplate") %>

<div class="row mt-5 mb-5">

    <div class="col-md-6 offset-md-3">

        <div class="card shadow">

            <div class="card-header text-center">

                <h4 class="mb-0">
                    <i class="fa-solid fa-lock"></i>
                    Secure Payment
                </h4>

            </div>


            <div class="card-body p-4">


                <!-- Booking Details -->

                <div class="mb-4">

                    <h5>
                        <%= booking.listing.title %>
                    </h5>

                    <p class="text-muted mb-1">

                        <i class="fa-solid fa-location-dot"></i>

                        <%= booking.listing.location %>,
                        <%= booking.listing.country %>

                    </p>

                </div>


                <hr>


                <!-- Dates -->

                <div class="d-flex justify-content-between mb-2">

                    <span>
                        Check-in
                    </span>

                    <strong>
                        <%= booking.checkIn.toDateString() %>
                    </strong>

                </div>


                <div class="d-flex justify-content-between mb-2">

                    <span>
                        Check-out
                    </span>

                    <strong>
                        <%= booking.checkOut.toDateString() %>
                    </strong>

                </div>


                <div class="d-flex justify-content-between mb-2">

                    <span>
                        Guests
                    </span>

                    <strong>
                        <%= booking.guests %>
                    </strong>

                </div>


                <div class="d-flex justify-content-between mb-3">

                    <span>
                        Nights
                    </span>

                    <strong>
                        <%= booking.nights %>
                    </strong>

                </div>


                <hr>


                <!-- Amount -->

                <div class="d-flex justify-content-between mb-4">

                    <h5>
                        Total Amount
                    </h5>

                    <h5>
                        ₹ <%= booking.totalAmount.toLocaleString("en-IN") %>
                    </h5>

                </div>


                <!-- Payment Information -->

                <div class="alert alert-info">

                    <i class="fa-solid fa-circle-info"></i>

                    This is a demo payment for the
                    WanderLust project.

                    No real money will be charged.

                </div>


                <!-- Payment Form -->

                <form
                    id="mockPaymentForm"
                    data-booking-id="<%= booking._id %>"
                >


                    <div class="mb-3">

                        <label
                            for="cardName"
                            class="form-label"
                        >
                            Card Holder Name
                        </label>

                        <input
                            type="text"
                            id="cardName"
                            class="form-control"
                            placeholder="Enter your name"
                            required
                        >

                    </div>


                    <div class="mb-3">

                        <label
                            for="cardNumber"
                            class="form-label"
                        >
                            Card Number
                        </label>

                        <input
                            type="text"
                            id="cardNumber"
                            class="form-control"
                            placeholder="1234 5678 9012 3456"
                            maxlength="19"
                            required
                        >

                    </div>


                    <div class="row mb-3">

                        <div class="col-md-6">

                            <label
                                for="expiry"
                                class="form-label"
                            >
                                Expiry
                            </label>

                            <input
                                type="text"
                                id="expiry"
                                class="form-control"
                                placeholder="MM/YY"
                                required
                            >

                        </div>


                        <div class="col-md-6">

                            <label
                                for="cvv"
                                class="form-label"
                            >
                                CVV
                            </label>

                            <input
                                type="password"
                                id="cvv"
                                class="form-control"
                                placeholder="123"
                                maxlength="3"
                                required
                            >

                        </div>

                    </div>


                    <button
                        type="submit"
                        id="payButton"
                        class="btn btn-danger w-100"
                    >

                        <i class="fa-solid fa-credit-card"></i>

                        Pay ₹ <%= booking.totalAmount.toLocaleString("en-IN") %>

                    </button>


                </form>


                <div class="text-center mt-3">

                    <a
                        href="/listings/<%= booking.listing._id %>"
                        class="text-muted"
                    >
                        Cancel Payment
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


<script src="/js/mockPayment.js"></script>