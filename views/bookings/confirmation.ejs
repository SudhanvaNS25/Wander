<% layout("/layouts/boilerplate") %>

<div class="container mt-5 mb-5">

    <div class="row">

        <div class="col-md-8 offset-md-2">

            <div class="card shadow-sm">

                <!-- SUCCESS HEADER -->

                <div class="card-body text-center p-5">

                    <div class="mb-4">

                        <i
                            class="fa-solid fa-circle-check text-success"
                            style="font-size: 70px;"
                        ></i>

                    </div>


                    <h2 class="text-success mb-3">
                        Booking Confirmed!
                    </h2>


                    <p class="text-muted">
                        Your booking has been successfully confirmed.
                    </p>

                </div>


                <hr class="m-0">


                <!-- BOOKING DETAILS -->

                <div class="card-body p-4">

                    <h4 class="mb-4">
                        Booking Details
                    </h4>


                    <!-- Listing -->

                    <div class="d-flex align-items-center mb-4">

                        <% if(booking.listing.image &&
                              booking.listing.image.url){ %>

                            <img
                                src="<%= booking.listing.image.url %>"
                                alt="<%= booking.listing.title %>"
                                style="
                                    width: 100px;
                                    height: 80px;
                                    object-fit: cover;
                                "
                                class="rounded me-3"
                            >

                        <% } %>


                        <div>

                            <h5 class="mb-1">
                                <%= booking.listing.title %>
                            </h5>

                            <p class="text-muted mb-0">

                                <i
                                    class="fa-solid fa-location-dot"
                                ></i>

                                <%= booking.listing.location %>,
                                <%= booking.listing.country %>

                            </p>

                        </div>

                    </div>


                    <hr>


                    <!-- CHECK-IN -->

                    <div class="row mb-3">

                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Check-in
                            </p>

                            <strong>

                                <%= booking.checkIn.toLocaleDateString(
                                    "en-IN",
                                    {
                                        day: "2-digit",
                                        month: "long",
                                        year: "numeric"
                                    }
                                ) %>

                            </strong>

                        </div>


                        <!-- CHECK-OUT -->

                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Check-out
                            </p>

                            <strong>

                                <%= booking.checkOut.toLocaleDateString(
                                    "en-IN",
                                    {
                                        day: "2-digit",
                                        month: "long",
                                        year: "numeric"
                                    }
                                ) %>

                            </strong>

                        </div>

                    </div>


                    <!-- GUESTS + NIGHTS -->

                    <div class="row mb-3">

                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Guests
                            </p>

                            <strong>

                                <%= booking.guests %>

                                <%= booking.guests === 1
                                    ? "Guest"
                                    : "Guests"
                                %>

                            </strong>

                        </div>


                        <div class="col-md-6">

                            <p class="text-muted mb-1">
                                Nights
                            </p>

                            <strong>

                                <%= booking.nights %>

                                <%= booking.nights === 1
                                    ? "Night"
                                    : "Nights"
                                %>

                            </strong>

                        </div>

                    </div>


                    <hr>


                    <!-- PRICE -->

                    <div class="d-flex justify-content-between mb-2">

                        <span>
                            Price per night
                        </span>

                        <span>

                            ₹ <%= booking.listing.price.toLocaleString(
                                "en-IN"
                            ) %>

                        </span>

                    </div>


                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            <%= booking.nights %> nights
                        </span>

                        <span>

                            ₹ <%= booking.totalAmount.toLocaleString(
                                "en-IN"
                            ) %>

                        </span>

                    </div>


                    <hr>


                    <!-- TOTAL -->

                    <div class="d-flex justify-content-between">

                        <h5>
                            Total Paid
                        </h5>

                        <h5 class="text-success">

                            ₹ <%= booking.totalAmount.toLocaleString(
                                "en-IN"
                            ) %>

                        </h5>

                    </div>


                    <!-- PAYMENT STATUS -->

                    <div class="mt-4">

                        <div class="alert alert-success">

                            <i
                                class="fa-solid fa-circle-check me-2"
                            ></i>

                            Payment Status:

                            <strong>
                                <%= booking.paymentStatus.toUpperCase() %>
                            </strong>

                        </div>

                    </div>


                    <!-- PAYMENT ID -->

                    <% if(booking.paymentId){ %>

                        <div class="mt-3">

                            <p class="text-muted mb-1">
                                Payment ID
                            </p>

                            <code>
                                <%= booking.paymentId %>
                            </code>

                        </div>

                    <% } %>


                    <!-- BOOKING ID -->

                    <div class="mt-3">

                        <p class="text-muted mb-1">
                            Booking ID
                        </p>

                        <code>
                            <%= booking._id %>
                        </code>

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="card-footer bg-white p-4">

                    <div class="d-flex justify-content-center gap-2">

                        <a
                            href="/listings"
                            class="btn btn-danger"
                        >

                            <i
                                class="fa-solid fa-compass"
                            ></i>

                            Explore Listings

                        </a>


                        <a
                            href="/listings/<%= booking.listing._id %>"
                            class="btn btn-outline-secondary"
                        >

                            Back to Listing

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>